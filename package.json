{
  "name": "vs-md-theme-maker",
  "version": "1.0.1",
  "description": "VS MD Theme Maker — Markdown preview theme gallery & installer for VS Code / Antigravity IDE",
  "author": "VS MD Theme Maker",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/settings-writer.test.js test/theme-customizer.test.js test/project-registry.test.js test/markdown-engine.test.js test/theme-installer.test.js test/dependency-checker.test.js",
    "build": "electron-builder --win portable nsis",
    "build:portable": "electron-builder --win portable",
    "build:installer": "electron-builder --win nsis"
  },
  "build": {
    "appId": "com.vsmdthememaker.app",
    "productName": "VS MD Theme Maker",
    "publish": null,
    "compression": "maximum",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json",
      "!test/**",
      "!dist/**",
      "!node_modules/.cache/**"
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "differentialPackage": false
    }
  },
  "devDependencies": {
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "highlight.js": "^11.11.1",
    "jsonc-parser": "^3.3.1",
    "katex": "^0.18.4",
    "markdown-it": "^15.0.0",
    "mermaid": "^11.16.1"
  }
}
